# Copy this file to .env before running.

# Core
COMPOSE_PROJECT_NAME=ai-assistant-ivan
TZ=America/Vancouver
OPENCLAW_PORT=18789
OPENCLAW_WEB_PORT=18889
OPENCLAW_HOME=./openclaw-home

# LLM provider
# Development default: OpenRouter free tier
# Production note: free-tier routing is fine for setup and smoke tests, but not ideal for dependable automation.
# Set only the provider-specific keys you actually plan to use.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OLLAMA_API_KEY=

# OpenClaw runtime
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_HOST=0.0.0.0
OPENCLAW_LOG_LEVEL=info
OPENCLAW_AUTH_TOKEN=

# Future integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=

# Reverse proxy or hostname later if needed
AI_ASSISTANT_IVAN_DOMAIN=
